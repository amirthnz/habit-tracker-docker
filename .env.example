# Copy this file to `.env` (same folder as docker-compose.yml) on your VPS
# and fill in the values before running `docker compose up`.

# Gemini API key — used for AI habit badges and coaching insights.
# Optional: the app falls back to static badges when empty.
GEMINI_API_KEY=

# Django secret key — REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Keep 0 in production.
DJANGO_DEBUG=0

# Defaults to "*" so a fresh VPS works immediately. Once you have a domain,
# lock it down, e.g.: DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=*

# Set once you serve the site over HTTPS (e.g. behind Caddy/nginx + certbot):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
